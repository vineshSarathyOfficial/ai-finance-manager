generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum AccountType {
  BANK
  CREDIT_CARD
  CASH
  OTHER
}

enum TransactionKind {
  REGULAR
  TRANSFER
  REFUND
  CC_PAYMENT
  EXCLUDED
}

enum EmiStatus {
  ACTIVE
  COMPLETED
}

enum InvestmentType {
  SIP
  EPFO
  LUMP_SUM
  FD
  OTHER
}

enum ImportStatus {
  PENDING
  PROCESSED
  FAILED
}

enum Frequency {
  WEEKLY
  BIWEEKLY
  MONTHLY
  QUARTERLY
  YEARLY
}

enum InsightPeriod {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

model User {
  id           String   @id @default(cuid())
  name         String?
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  googleConnected    Boolean   @default(false)
  googleEmail        String?
  googleAccessToken  String?
  googleRefreshToken String?
  googleTokenExpiry  DateTime?
  lastGmailSyncAt    DateTime?

  categories            Category[]
  transactions          Transaction[]
  statementImports      StatementImport[]
  recurringTransactions RecurringTransaction[]
  accounts              Account[]
  budgets               Budget[]
  insightReports        InsightReport[]
  categoryRules         CategoryRule[]
  savingsGoals          SavingsGoal[]
  creditCardEmis        CreditCardEmi[]
  investments           Investment[]
  notificationPreference NotificationPreference?
  pushSubscriptions     PushSubscription[]
  notificationDeliveries NotificationDeliveryLog[]
}

model Account {
  id                 String      @id @default(cuid())
  userId             String
  name               String
  type               AccountType @default(BANK)
  institution        String?
  lastFour           String?
  creditLimit        Decimal?    @db.Decimal(12, 2)
  openingOutstanding Decimal     @default(0) @db.Decimal(12, 2)
  billingCycleDay    Int?
  paymentDueDay      Int?
  isDefault          Boolean     @default(false)
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  creditCardEmis CreditCardEmi[]

  @@index([userId])
}

model Category {
  id        String          @id @default(cuid())
  userId    String
  name      String
  type      TransactionType
  icon      String?
  createdAt DateTime        @default(now())

  user                  User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions          Transaction[]
  recurringTransactions RecurringTransaction[]
  budgets               Budget[]
  categoryRules         CategoryRule[]
  transactionSplits     TransactionSplit[]

  @@unique([userId, name, type])
}

model Transaction {
  id                  String          @id @default(cuid())
  userId              String
  type                TransactionType
  amount              Decimal         @db.Decimal(12, 2)
  description         String
  categoryId          String
  transactionDate     DateTime
  paymentMethod       String?
  notes               String?
  importId            String?
  source              String?         @default("MANUAL")
  emailMessageId      String?
  accountId           String?
  merchantName        String?
  transactionKind     TransactionKind @default(REGULAR)
  linkedTransactionId String?
  emiId               String?
  excludeFromTotals   Boolean         @default(false)
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  category        Category         @relation(fields: [categoryId], references: [id])
  statementImport StatementImport? @relation(fields: [importId], references: [id])
  account         Account?         @relation(fields: [accountId], references: [id], onDelete: SetNull)
  emi             CreditCardEmi?   @relation(fields: [emiId], references: [id], onDelete: SetNull)
  splits          TransactionSplit[]

  @@index([userId, emiId])

  @@index([userId, emailMessageId])
  @@index([userId, transactionDate])
  @@index([userId, categoryId])
  @@index([userId, accountId])
  @@index([userId, merchantName])
  @@index([userId, transactionKind])
}

model StatementImport {
  id             String       @id @default(cuid())
  userId         String
  fileName       String
  source         String
  status         ImportStatus @default(PENDING)
  importedCount  Int          @default(0)
  duplicateCount Int          @default(0)
  createdAt      DateTime     @default(now())

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
}

model RecurringTransaction {
  id          String          @id @default(cuid())
  userId      String
  name        String
  categoryId  String?
  type        TransactionType @default(EXPENSE)
  amount      Decimal         @db.Decimal(12, 2)
  frequency   Frequency
  nextDueDate DateTime?
  lastSeenAt  DateTime?
  isActive    Boolean         @default(true)
  matchKey    String
  occurrences Int             @default(0)
  confidence  Int             @default(0)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@unique([userId, matchKey])
  @@index([userId, isActive])
}

model Budget {
  id           String   @id @default(cuid())
  userId       String
  categoryId   String
  monthlyLimit Decimal  @db.Decimal(12, 2)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([userId, categoryId])
  @@index([userId])
}

model InsightReport {
  id          String        @id @default(cuid())
  userId      String
  period      InsightPeriod
  periodKey   String
  facts       Json
  insights    Json
  summaryText String?
  generatedAt DateTime      @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, period, periodKey])
  @@index([userId, period, generatedAt])
}

model NotificationPreference {
  userId               String  @id
  timezone             String  @default("Asia/Kolkata")
  pushEnabled          Boolean @default(false)
  dailyEnabled         Boolean @default(true)
  dailyTime            String  @default("21:30")
  dailyWeekendsEnabled Boolean @default(true)
  weeklyEnabled        Boolean @default(true)
  weeklyDay            Int     @default(0)
  weeklyTime           String  @default("20:00")
  monthlyEnabled       Boolean @default(true)
  monthlyDay           Int     @default(1)
  monthlyTime          String  @default("09:00")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model NotificationDeliveryLog {
  id        String        @id @default(cuid())
  userId    String
  period    InsightPeriod
  periodKey String
  channel   String        @default("push")
  sentAt    DateTime      @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, period, periodKey, channel])
  @@index([userId, sentAt])
}

model CategoryRule {
  id         String          @id @default(cuid())
  userId     String
  keyword    String
  categoryId String
  type       TransactionType
  priority   Int             @default(0)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([userId, keyword, type])
  @@index([userId])
}

model SavingsGoal {
  id            String    @id @default(cuid())
  userId        String
  name          String
  targetAmount  Decimal   @db.Decimal(12, 2)
  currentAmount Decimal   @default(0) @db.Decimal(12, 2)
  targetDate    DateTime?
  icon          String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Investment {
  id                   String         @id @default(cuid())
  userId               String
  type                 InvestmentType
  name                 String
  institution          String?
  currentValue         Decimal        @db.Decimal(12, 2)
  investedAmount       Decimal?       @db.Decimal(12, 2)
  monthlyContribution  Decimal?       @db.Decimal(12, 2)
  employerContribution Decimal?       @db.Decimal(12, 2)
  startDate            DateTime?
  targetAmount         Decimal?       @db.Decimal(12, 2)
  notes                String?
  lastValueUpdate      DateTime?
  isActive             Boolean        @default(true)
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@index([userId, isActive])
}

model CreditCardEmi {
  id                     String    @id @default(cuid())
  userId                 String
  accountId              String
  name                   String
  originalAmount         Decimal   @db.Decimal(12, 2)
  monthlyAmount          Decimal   @db.Decimal(12, 2)
  remainingPrincipal     Decimal   @db.Decimal(12, 2)
  totalTenureMonths      Int
  remainingMonths        Int
  startDate              DateTime
  endDate                DateTime?
  interestRate           Decimal?  @db.Decimal(5, 2)
  processingFee          Decimal?  @db.Decimal(12, 2)
  status                 EmiStatus @default(ACTIVE)
  convertedTransactionId String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  account      Account       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@index([userId, accountId])
  @@index([userId, status])
}

model TransactionSplit {
  id            String  @id @default(cuid())
  transactionId String
  categoryId    String
  amount        Decimal @db.Decimal(12, 2)

  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  category    Category    @relation(fields: [categoryId], references: [id])

  @@index([transactionId])
}
